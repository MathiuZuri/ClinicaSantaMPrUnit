@using Clinica.WASM.DTOs.Auth

<MudDialog Class="luxury-auth-dialog rounded-xl">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="fw-800">Actualizar Contraseña</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Info" Class="mb-4">
            Introduzca sus credenciales actuales para validar su identidad y establecer su nueva clave de firmas.
        </MudText>
        
        <EditForm Model="@Model" OnValidSubmit="CambiarAsync">
            <DataAnnotationsValidator />
            
            <div class="d-flex flex-column gap-4">
                <MudTextField @bind-Value="Model.ContrasenaActual"
                              Label="Contraseña actual"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.VpnKey"
                              AdornmentColor="Color.Primary"
                              Required="true"
                              For="@(() => Model.ContrasenaActual)"
                              Class="rounded-lg" />

                <MudTextField @bind-Value="Model.ContrasenaNueva"
                              Label="Nueva contraseña"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              AdornmentColor="Color.Primary"
                              Required="true"
                              For="@(() => Model.ContrasenaNueva)"
                              HelperText="La clave debe poseer un mínimo de 8 caracteres"
                              Class="rounded-lg" />
            </div>

            <div class="d-flex justify-end align-center mt-5 pt-3 border-top-div">
                <MudButton OnClick="Cancelar" Variant="Variant.Text" Color="Color.Default" Class="mr-2 rounded-lg px-4">
                    Cancelar
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-lg shadow-sm px-5" Disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Actualizando...</span>
                    }
                    else
                    {
                        <span>Cambiar Contraseña</span>
                    }
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

<style>
    /* Estilos embebidos específicos con escape seguro de selectores */
    .luxury-auth-dialog {
        border: 1px solid rgba(var(--mud-palette-primary-rgb), 0.12) !important;
        box-shadow: var(--mud-elevation-24) !important;
    }
    .border-top-div {
        border-top: 1px solid var(--mud-palette-divider);
    }
</style>