# ===============================================
# .NET Build artifacts
# ===============================================
**/bin/
**/obj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# ===============================================
# Rider / Visual Studio
# ===============================================
.idea/
.vs/
*.sln.iml

# ===============================================
# Test results (dotnet test, VSTest)
# ===============================================
*.trx
*.coverage
*.coveragexml

# ===============================================
# Playwright E2E tests
# ===============================================
**/videos/
**/screenshots/
**/allure-results/
**/allure-report/
**/playwright-report/
**/playwright/.cache/

# ===============================================
# SonarQube / SonarScanner
# ===============================================
.sonarqube/
.scannerwork/
**/sonarqube/

# ===============================================
# Logs
# ===============================================
*.log

# ===============================================
# Docker temporary data
# ===============================================
docker-data/

# ===============================================
# Publish output
# ===============================================
publish/

# ===============================================
# Infrastructure (opcional, solo si no versionas)
# Si necesitas conservar docker-compose.yml,
# comenta la línea `infra/` y excluye solo los datos de SonarQube
# ===============================================
# infra/   ← Descomentar si realmente quieres ignorar toda la carpeta infra
# Si prefieres mantener docker-compose.yml pero ignorar el resto:
infra/sonarqube/data
infra/sonarqube/extensions
infra/sonarqube/logs
infra/**/*.jar
infra/**/*.cfs
infra/**/data/